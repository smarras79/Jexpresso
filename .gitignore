docs/build/
plotnodes.py
Manifest.toml
output/*
LocalPreferences.toml
*.pvtu
*.vtu
.jexpresso_cache/
*.code-workspace
jexpresso_mpi_stack.txt

# meshes/ is the link to the smarras79/JexpressoMeshes repository — local to
# each developer, never part of this repository. It therefore does not exist
# on a CI runner: a case that CI runs must keep its mesh inside this repo,
# next to its deck (problems/<EQS>/<CASE>/<mesh>.msh), and point
# :gmsh_filename there. test/ci_cases.jl validates that.
meshes
mesh.log

# LaTeX build artifacts (docs/*.tex compiled locally)
docs/*.aux
docs/*.log
docs/*.out
docs/*.pdf
docs/*.toc
docs/*.fls
docs/*.fdb_latexmk
docs/*.synctex.gz

# Python bytecode caches
__pycache__/
*.pyc

# Element-Learning pipeline (tools/EL_training/run_element_learning.sh)
tools/EL_training/element_learning.config
# Sampled tensors (optionally tagged per test: input_tensor_<tag>.csv)
input_tensor*.csv
output_tensor*.csv
tools/EL_training/input_tensor*.csv
tools/EL_training/output_tensor*.csv
# Trained-model artifacts produced by the pipeline / trainers
JX_NN*.onnx
tools/EL_training/*.onnx
tools/EL_training/*.pth
tools/EL_training/*.mat
tools/EL_training/*_training.png

# Run output of a CI case: regenerated by every run. What gets committed is
# the reference in test/CI-ref/, never the run itself — so that `git add
# test/CI-runs` after adding a case picks up the deck only.
test/CI-runs/**/output/

# SEM preprocess caches written next to a case (mod_mesh: MESH_<grid>_nop<N>.jld2)
MESH_*.jld2
problems/MHD/brioWu1d/curves/
problems/MHD/smoothVortex/errors/

# sweep logs written by tools/smooth_vortex_mpi_scan.sh
logs/

# Measured errors of the smooth-vortex convergence sweeps: run output, not
# source. The sweep driver rewrites the whole store on every run (SV_KEEP=1
# to append instead), so tracking them makes every run dirty the tree.
problems/*/smoothVortex/errors/
problems/*/smoothVortex/errors.prev/
