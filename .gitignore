docs/build/
plotnodes.py
Manifest.toml
output/*
LocalPreferences.toml
*.pvtu
*.vtu
.jexpresso_cache/
*.code-workspace
jexpresso_mpi_stack.txt

# meshes/ is the link to the smarras79/JexpressoMeshes repository — local to
# each developer, never part of this repository. It therefore does not exist
# on a CI runner: a case that CI runs must keep its mesh inside this repo,
# next to its deck (problems/<EQS>/<CASE>/<mesh>.msh), and point
# :gmsh_filename there. test/ci_cases.jl validates that.
meshes
mesh.log

# Run output of a CI case: regenerated by every run. What gets committed is
# the reference in test/CI-ref/, never the run itself — so that `git add
# test/CI-runs` after adding a case picks up the deck only.
test/CI-runs/**/output/

# SEM preprocess caches written next to a case (mod_mesh: MESH_<grid>_nop<N>.jld2)
MESH_*.jld2

# HEVI case output trees (problems/CompEuler/rtb_hevi writes one per scheme,
# so an A/B leaves both solutions on disk). Regenerated by every run.
output_hevi/
output_explicit/
