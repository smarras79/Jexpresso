# =============================================================================
#  Settings for the 3D periodic Poisson solver comparison on NJIT Wulver.
#  Sourced by submit_wulver3d.sh and by every job. Edit, then run
#      bash tools/poisson3d_benchmark/slurm/submit_wulver3d.sh
#  (DRY_RUN=1 first, to see the job table without submitting.)
# =============================================================================

# --- SLURM account and queue --------------------------------------------------
# Wulver: partition "general" = 128 cores / 512 GB per node, "bigmem" = 128
# cores / 2 TB; QoS "standard" (charged, 72 h), "low" (free, 72 h, preemptible:
# jobs are requeued and skip what they already finished), "high_<PI>".
# An SU is MAX(#CPUs, memory in GB / 4) per hour.
ACCOUNT="PI_ucid"                 # <-- your PI's UCID (sbatch --account)
PARTITION="general"
QOS="standard"
BIGMEM_PARTITION="bigmem"
GENERAL_MAX_GB=500                # jobs that need more go to BIGMEM_PARTITION
BIGMEM_MAX_GB=1950                # jobs that need more are not submitted (reported)
MAX_HOURS=72                      # jobs estimated longer are not submitted (reported)

# --- Julia and the repository --------------------------------------------------
# Julia 1.11.9, e.g. with juliaup in $HOME:
#   curl -fsSL https://install.julialang.org | sh -s -- -y ; juliaup add 1.11.9
# or a module: set JULIA_MODULE (see `module spider julia`) and JULIA=julia.
JULIA="$HOME/.juliaup/bin/julia +1.11.9"
JULIA_MODULE=""
JULIA_DEPOT=""                    # package depot on a filesystem the nodes see; empty = ~/.julia
REPO="$HOME/Jexpresso"            # checkout of sm/elementLearning
PYTHON="python3"                  # figures (no packages needed)

# --- What to run ---------------------------------------------------------------
OUTDIR="$REPO/ppb3d_wulver"       # results, logs, figures
D=3                               # dimension (3; 2 also works)
R=0.5                             # Fourier decay rate of the exact solution
ORDERING="metis"                  # fill-reducing ordering of the Cholesky factorisations
RTOL=1e-12                        # CG tolerance (relative, preconditioned residual)
WARMUP="small"                    # small | same (the discarded first run)
SOLVERS="sem sem_amg sem_jacobi sc_direct sc_amg ps fft"
# Sweeps: "N:ne1,ne2,..." per SEM order; unknowns n = (ne*N)^3.
#   N = 2: ne = 8 .. 128  ->  n = 4.1e3 .. 1.7e7
#   N = 4: ne = 4 .. 64   ->  n = 4.1e3 .. 1.7e7
SWEEPS="2:8,12,16,24,32,48,64,96,128 4:4,6,8,12,16,24,32,48,64"

# --- Cores ---------------------------------------------------------------------
# Threads per run (Julia threads for the element loops of static condensation
# and the right-hand side; BLAS threads for CHOLMOD's supernodal factorisation
# and the dense kernels), by problem size, the same for every solver at a given
# n. NOTE: AlgebraicMultigrid.jl and the CG iterations are single-threaded, so
# threads favour the direct solvers; set all three to 1 for a single-core
# comparison of the algorithms.
THREADS_SMALL=1                   # n <  THREADS_BREAK1
THREADS_MEDIUM=4                  # n <  THREADS_BREAK2
THREADS_LARGE=16                  # otherwise
THREADS_BREAK1=300000
THREADS_BREAK2=3000000
EXCLUSIVE=0                       # 1 = whole node per job (cleanest timings, 128 SU/h)
MEM_SAFETY=1.5                    # multiplier on the memory model
