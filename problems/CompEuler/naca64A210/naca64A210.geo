Plane Surface(1) = {1, 2};

// ---- element size ----------------------------------------------------
// Fine on the aerofoil, finer still at the two tips, coarse far away.
// Distance/Threshold rather than a background mesh so the grading follows
// the geometry rather than the box.
Field[1] = Distance;
Field[1].CurvesList = {5, 6};
Field[1].Sampling = 400;
Field[2] = Threshold;
Field[2].InField = 1;
Field[2].SizeMin = 0.0048;
Field[2].SizeMax = 0.1;
Field[2].DistMin = 0.03;
Field[2].DistMax = 0.9;

// The leading and trailing edges: the nose radius is 0.0056c and the
// trailing edge is a corner, so both need to be finer than the surface.
Field[3] = Distance;
Field[3].PointsList = {218, 100};
Field[4] = Threshold;
Field[4].InField = 3;
Field[4].SizeMin = 0.0036;
Field[4].SizeMax = 0.1;
Field[4].DistMin = 0.018;
Field[4].DistMax = 0.15;


// The wake. Everything the trailing edge sheds goes through here.
Field[5] = Box;
Field[5].VIn  = 0.01;
Field[5].VOut = 0.1;
Field[5].XMin = 1.6;
Field[5].XMax = 2.44;
Field[5].YMin = -0.12;
Field[5].YMax = 0.12;
Field[5].Thickness = 0.09;

Field[6] = Min;
Field[6].FieldsList = {2, 4, 5};
Background Field = 6;
Mesh.MeshSizeExtendFromBoundary = 0;
Mesh.MeshSizeFromPoints = 0;
Mesh.MeshSizeFromCurvature = 0;

// ---- quads -----------------------------------------------------------
// Jexpresso's 2D reader wants quadrilaterals, and it wants ALL of them:
// a quad-dominant mesh with a few leftover triangles is not a mesh it can
// read. Plain blossom (RecombinationAlgorithm = 1) leaves a few hundred
// triangles behind on this geometry, so use the full-quad variant, which
// splits whatever it cannot pair.
Recombine Surface {1};
Mesh.RecombinationAlgorithm = 3;   // blossom, full-quad
Mesh.Algorithm = 8;                // frontal-Delaunay for quads

// ---- physical groups -------------------------------------------------
// These names are what user_bc.jl dispatches on, and "airfoil" is what
// :exact_geometry names in user_inputs.jl.
Physical Curve("bottom",  1) = {1};
Physical Curve("outflow", 2) = {2};
Physical Curve("top",     3) = {3};
Physical Curve("inflow",  4) = {4};
Physical Curve("airfoil", 5) = {5, 6};
Physical Surface("domain") = {1};
