Spline(41) = {4001:4099};   // upper surface, TE tangency -> LE
Spline(42) = {4099:4201};   // lower surface, LE -> TE tangency
Circle(43) = {4201, 4202, 4203};   // lower tangency -> apex
Circle(44) = {4203, 4202, 4001};   // apex -> upper tangency
Curve Loop(5) = {41, 42, 43, 44};

Curve Loop(1) = {1, 2, 3, 4};      // tunnel, counter-clockwise
Plane Surface(1) = {1, 2, 3, 4, 5};        // the tunnel with four holes

// ---- element size ----------------------------------------------------
// Distance/Threshold rather than a background mesh so the grading follows
// the geometry. The slots between the elements sit inside the near band,
// so they are meshed at H_SURF.
Field[1] = Distance;
Field[1].CurvesList = {11, 12, 13, 14, 21, 22, 23, 24, 31, 32, 33, 34, 41, 42, 43, 44};
Field[1].Sampling = 400;
Field[2] = Threshold;
Field[2].InField = 1;
Field[2].SizeMin = 0.005;
Field[2].SizeMax = 0.1;
Field[2].DistMin = 0.03;
Field[2].DistMax = 0.9;

// Every leading edge and every trailing-edge apex. The smallest TE arc
// must carry several elements or gmsh returns inverted quads.
Field[3] = Distance;
Field[3].PointsList = {1097, 1203, 2099, 2203, 3105, 3203, 4099, 4203};
Field[4] = Threshold;
Field[4].InField = 3;
Field[4].SizeMin = 0.0012;
Field[4].SizeMax = 0.1;
Field[4].DistMin = 0.01;
Field[4].DistMax = 0.12;

// The wake. Everything the four elements shed goes through here.
Field[5] = Box;
Field[5].VIn  = 0.01;
Field[5].VOut = 0.1;
Field[5].XMin = 1.87;
Field[5].XMax = 2.7;
Field[5].YMin = -0.42;
Field[5].YMax = 0.1;
Field[5].Thickness = 0.1;

Field[6] = Min;
Field[6].FieldsList = {2, 4, 5};
Background Field = 6;
Mesh.MeshSizeExtendFromBoundary = 0;
Mesh.MeshSizeFromPoints = 0;
Mesh.MeshSizeFromCurvature = 0;

// ---- quads -----------------------------------------------------------
// Jexpresso's 2D reader wants quadrilaterals, and ALL of them: a
// quad-dominant mesh with leftover triangles is not one it can read.
Recombine Surface {1};
Mesh.RecombinationAlgorithm = 3;   // blossom, full-quad
Mesh.Algorithm = 8;                // frontal-Delaunay for quads

// ---- physical groups -------------------------------------------------
// user_bc.jl treats anything that is not "inflow" or "outflow" as a
// free-slip wall, so all four elements and the two tunnel walls are walls.
// These names are also the keys of :exact_geometry in user_inputs.jl.
Physical Curve("bottom",  1) = {1};
Physical Curve("outflow", 2) = {2};
Physical Curve("top",     3) = {3};
Physical Curve("inflow",  4) = {4};
Physical Curve("slat", 5) = {11, 12, 13, 14};
Physical Curve("main", 6) = {21, 22, 23, 24};
Physical Curve("flap1", 7) = {31, 32, 33, 34};
Physical Curve("flap2", 8) = {41, 42, 43, 44};
Physical Surface("domain") = {1};
